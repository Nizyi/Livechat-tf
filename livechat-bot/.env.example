# Token du bot Discord (obtenu sur https://discord.com/developers/applications)
TOKEN=

# ID du salon Discord à surveiller (clic droit sur le salon → Copier l'ID, mode dev activé)
CHANNEL_ID=

# Port d'écoute du serveur WebSocket local
PORT=8080

# Secret partagé entre le bot et l'overlay (≥16 caractères, recommandé 32+ aléatoires)
# Génère par exemple via : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WS_TOKEN=

# Délai minimum entre deux messages broadcastés par le même user, en ms (défaut 5000)
COOLDOWN_MS=5000

# Délai avant suppression auto du message Discord après broadcast, en ms (défaut 10000, 0 pour désactiver)
# Nécessite la permission "Manage Messages" pour le bot dans le salon.
DELETE_AFTER_MS=10000
