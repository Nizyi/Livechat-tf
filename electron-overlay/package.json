{
  "name": "livechat-overlay",
  "version": "1.5.0",
  "description": "Overlay transparent LiveChat – affiche les contenus reçus du bot Discord",
  "author": "Nizyi",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nizyi/Livechat-tf.git"
  },
  "build": {
    "appId": "com.livechat.overlay",
    "publish": {
      "provider": "github",
      "owner": "Nizyi",
      "repo": "Livechat-tf",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "logo.jpg"
    },
    "files": [
      "**/*",
      "!.env.build",
      "!.env.example"
    ]
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.1.0",
    "nsfwjs": "^4.3.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1"
  }
}
