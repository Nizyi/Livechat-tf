# Configuration bakée au build dans l'app distribuée.
# Copie ce fichier en `.env` et remplis les valeurs avant `npm run dist`.
# Le `.env` est gitignored — il ne sera jamais commité, mais il EST inclus
# dans l'installer NSIS (tes users finaux n'ont rien à configurer).

# Adresse du serveur WebSocket du bot, format "host:port"
WS_HOST=

# Secret partagé avec le bot (≥16 chars, identique à WS_TOKEN dans .env du bot)
WS_TOKEN=
